    (= dossier_prmt5.cited-records registry_prmt5.subject-records)
    :using (dossier_prmt5.cited-records registry_prmt5.subject-records))

(derive prmt5-clean-of-off-target
    (= registry_prmt5.off-target 0)
    :using (registry_prmt5.off-target))

(derive prmt5-clean-of-retracted
