; checks.pltg — every place the two descriptions can disagree.
; A diff that holds is silent; a diff that fails is a proved inconsistency.

; ---------------------------------------------------------- EGFR

(diff egfr-support-base
    :replace dossier_egfr.cited-records
    :with registry_egfr.subject-records)

(diff egfr-off-target
    :replace dossier_egfr.assumed-off-target
    :with registry_egfr.off-target)

(diff egfr-retracted
    :replace dossier_egfr.assumed-retracted
    :with registry_egfr.retracted)

(diff egfr-unresolved
    :replace dossier_egfr.assumed-unresolved
    :with registry_egfr.unresolved)

(diff egfr-supports-pmid-42492133
    :replace dossier_egfr.supports-pmid-42492133
    :with registry_egfr.supports-pmid-42492133)

(diff egfr-supports-pmid-42576549
    :replace dossier_egfr.supports-pmid-42576549
    :with registry_egfr.supports-pmid-42576549)

(diff egfr-supports-pmid-42595923
    :replace dossier_egfr.supports-pmid-42595923
    :with registry_egfr.supports-pmid-42595923)

(diff egfr-supports-pmid-42609336
    :replace dossier_egfr.supports-pmid-42609336
    :with registry_egfr.supports-pmid-42609336)

(diff egfr-supports-pmid-42609500
    :replace dossier_egfr.supports-pmid-42609500
    :with registry_egfr.supports-pmid-42609500)

(diff egfr-supports-nct-NCT07503756
    :replace dossier_egfr.supports-nct-NCT07503756
    :with registry_egfr.supports-nct-NCT07503756)

(derive egfr-base-intact
    (= dossier_egfr.cited-records registry_egfr.subject-records)
    :using (dossier_egfr.cited-records registry_egfr.subject-records))

(derive egfr-clean-of-off-target
    (= registry_egfr.off-target 0)
    :using (registry_egfr.off-target))

(derive egfr-clean-of-retracted
    (= registry_egfr.retracted 0)
    :using (registry_egfr.retracted))

(derive egfr-all-records-resolve
    (= registry_egfr.unresolved 0)
    :using (registry_egfr.unresolved))

(derive egfr-has-subject-record
    (> registry_egfr.subject-records 0)
    :using (registry_egfr.subject-records))

(derive egfr-base-usable
    (and (and egfr-clean-of-off-target egfr-clean-of-retracted)
         (and egfr-all-records-resolve egfr-has-subject-record))
    :using (egfr-clean-of-off-target egfr-clean-of-retracted egfr-all-records-resolve egfr-has-subject-record))

(derive egfr-verdict-proven egfr-base-usable
    :using (egfr-base-usable))

