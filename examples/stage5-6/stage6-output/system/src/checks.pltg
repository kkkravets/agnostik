    :using (prmt5-base-usable))

; how many of the verdicts survive verification against the registries
(derive proven-verdicts
    (+ (if egfr-verdict-proven 1 0) (+ (if erbb2-verdict-proven 1 0) (+ (if kras-verdict-proven 1 0) (+ (if myc-verdict-proven 1 0) (+ (if wrn-verdict-proven 1 0) (if prmt5-verdict-proven 1 0))))))
    :using (egfr-verdict-proven erbb2-verdict-proven kras-verdict-proven myc-verdict-proven wrn-verdict-proven prmt5-verdict-proven))
