; KRAS — what the registries returned (stage 5)

(fact subject-records 3
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED subject_records=3")
        :explanation "Cited records whose registry entry names KRAS as its subject"))

(fact off-target 1
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED off_target=1")
        :explanation "Cited records that never name KRAS"))

(fact retracted 0
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED retracted=0")
        :explanation "Cited records that are retracted or under an expression of concern"))

(fact unresolved 0
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED unresolved=0")
        :explanation "Cited identifiers no registry could return"))

(fact supports-uniprot-P01116 true
    :evidence (evidence "registry-KRAS"
        :quotes ("uniprot P01116 | status=sound | gene_role=title | indication=not-applicable | resolves=True")
        :explanation "registry grade for P01116"))

(fact supports-pmid-42527030 false
    :evidence (evidence "registry-KRAS"
        :quotes ("pmid 42527030 | status=off-target | gene_role=absent | indication=title | resolves=True")
        :explanation "KRAS appears nowhere in the registry record, under any of its names"))

(fact supports-pmid-42557320 false
    :evidence (evidence "registry-KRAS"
        :quotes ("pmid 42557320 | status=weak-attribution | gene_role=abstract | indication=abstract | resolves=True")
        :explanation "KRAS appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

