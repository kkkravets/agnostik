; EGFR — what the registries returned (stage 5)

(fact subject-records 2
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED subject_records=2")
        :explanation "Cited records whose registry entry names EGFR as its subject"))

(fact off-target 0
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED off_target=0")
        :explanation "Cited records that never name EGFR"))

(fact retracted 0
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED retracted=0")
        :explanation "Cited records that are retracted or under an expression of concern"))

(fact unresolved 0
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED unresolved=0")
        :explanation "Cited identifiers no registry could return"))

(fact supports-uniprot-P00533 true
    :evidence (evidence "registry-EGFR"
        :quotes ("uniprot P00533 | status=sound | gene_role=title | indication=not-applicable | resolves=True")
        :explanation "registry grade for P00533"))

(fact supports-pmid-42492133 false
