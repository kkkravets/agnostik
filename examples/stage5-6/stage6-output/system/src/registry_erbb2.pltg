; ERBB2 — what the registries returned (stage 5)

(fact subject-records 3
    :evidence (evidence "registry-ERBB2"
        :quotes ("VERIFIED subject_records=3")
        :explanation "Cited records whose registry entry names ERBB2 as its subject"))

(fact off-target 0
    :evidence (evidence "registry-ERBB2"
        :quotes ("VERIFIED off_target=0")
        :explanation "Cited records that never name ERBB2"))

(fact retracted 0
    :evidence (evidence "registry-ERBB2"
        :quotes ("VERIFIED retracted=0")
        :explanation "Cited records that are retracted or under an expression of concern"))

(fact unresolved 0
    :evidence (evidence "registry-ERBB2"
        :quotes ("VERIFIED unresolved=0")
        :explanation "Cited identifiers no registry could return"))

(fact supports-uniprot-P04626 true
    :evidence (evidence "registry-ERBB2"
        :quotes ("uniprot P04626 | status=sound | gene_role=title | indication=not-applicable | resolves=True")
        :explanation "registry grade for P04626"))

