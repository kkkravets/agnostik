; MYC — what the registries returned (stage 5)

(fact subject-records 2
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED subject_records=2")
        :explanation "Cited records whose registry entry names MYC as its subject"))

(fact off-target 0
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED off_target=0")
        :explanation "Cited records that never name MYC"))

(fact retracted 0
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED retracted=0")
        :explanation "Cited records that are retracted or under an expression of concern"))

(fact unresolved 0
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED unresolved=0")
        :explanation "Cited identifiers no registry could return"))

(fact supports-uniprot-P01106 true
    :evidence (evidence "registry-MYC"
        :quotes ("uniprot P01106 | status=sound | gene_role=title | indication=not-applicable | resolves=True")
        :explanation "registry grade for P01106"))

(fact supports-pmid-42497765 false
    :evidence (evidence "registry-MYC"
        :quotes ("pmid 42497765 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "MYC appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

