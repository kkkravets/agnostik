; WRN — what the registries returned (stage 5)

(fact subject-records 4
    :evidence (evidence "registry-WRN"
        :quotes ("VERIFIED subject_records=4")
        :explanation "Cited records whose registry entry names WRN as its subject"))

(fact off-target 0
    :evidence (evidence "registry-WRN"
        :quotes ("VERIFIED off_target=0")
        :explanation "Cited records that never name WRN"))

(fact retracted 0
    :evidence (evidence "registry-WRN"
        :quotes ("VERIFIED retracted=0")
        :explanation "Cited records that are retracted or under an expression of concern"))

(fact unresolved 0
    :evidence (evidence "registry-WRN"
        :quotes ("VERIFIED unresolved=0")
        :explanation "Cited identifiers no registry could return"))

(fact supports-uniprot-Q14191 true
    :evidence (evidence "registry-WRN"
        :quotes ("uniprot Q14191 | status=sound | gene_role=title | indication=not-applicable | resolves=True")
        :explanation "registry grade for Q14191"))

(fact supports-pmid-40203476 false
