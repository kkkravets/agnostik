; MYC — registry verification results (stage 5)
; Every fact quotes docs/registry-MYC.txt, which is the recorded registry response.

(fact subject-records 2
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED subject_records=2")
        :explanation "Citations graded subject records for MYC"))

(fact weak-attribution 6
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED weak_attribution=6")
        :explanation "Citations graded weak attribution for MYC"))

(fact off-target 0
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED off_target=0")
        :explanation "Citations graded off target for MYC"))

(fact title-drift 0
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED title_drift=0")
        :explanation "Citations graded title drift for MYC"))

(fact retracted 0
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED retracted=0")
        :explanation "Citations graded retracted for MYC"))

(fact unresolved 0
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED unresolved=0")
        :explanation "Citations graded unresolved for MYC"))

(fact not-checked 0
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED not_checked=0")
        :explanation "Citations graded not checked for MYC"))

(fact checked-total 8
    :evidence (evidence "registry-MYC"
        :quotes ("VERIFIED checked_total=8")
        :explanation "Citations graded checked total for MYC"))

(fact finding-pmid-42497765 true
    :evidence (evidence "registry-MYC"
        :quotes ("pmid 42497765 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "MYC appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

(fact finding-pmid-42548213 true
    :evidence (evidence "registry-MYC"
        :quotes ("pmid 42548213 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "MYC appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

(fact finding-pmid-42607078 true
    :evidence (evidence "registry-MYC"
        :quotes ("pmid 42607078 | status=weak-attribution | gene_role=title | indication=absent | resolves=True")
        :explanation "record names no colorectal indication, so it does not speak to this disease"))

(fact finding-pmid-42608167 true
    :evidence (evidence "registry-MYC"
        :quotes ("pmid 42608167 | status=weak-attribution | gene_role=abstract | indication=absent | resolves=True")
        :explanation "MYC appears only in the abstract, not in the title, so it is not the subject of this record — and the record names no colorectal indication either"))

(fact finding-nct-NCT05919264 true
    :evidence (evidence "registry-MYC"
        :quotes ("nct NCT05919264 | status=weak-attribution | gene_role=absent | indication=abstract | resolves=True")
        :explanation "trial record names no MYC under any of its UniProt names — it was matched to this target by free-text search, and only the indication lines up"))

(fact finding-nct-NCT07147231 true
    :evidence (evidence "registry-MYC"
        :quotes ("nct NCT07147231 | status=weak-attribution | gene_role=absent | indication=title | resolves=True")
        :explanation "trial record names no MYC under any of its UniProt names — it was matched to this target by free-text search, and only the indication lines up"))

; --- derived: how much of this dossier's citation base is subject-level ---
(derive citations-all-sound (= weak-attribution 0) :using (weak-attribution))

(derive citations-none-off-target (= off-target 0) :using (off-target))

(derive citations-none-retracted (= retracted 0) :using (retracted))

(derive citations-all-resolve (= unresolved 0) :using (unresolved))
