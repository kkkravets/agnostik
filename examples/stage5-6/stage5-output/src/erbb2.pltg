; ERBB2 — registry verification results (stage 5)
; Every fact quotes docs/registry-ERBB2.txt, which is the recorded registry response.

(fact subject-records 3
    :evidence (evidence "registry-ERBB2"
        :quotes ("VERIFIED subject_records=3")
        :explanation "Citations graded subject records for ERBB2"))

(fact weak-attribution 7
    :evidence (evidence "registry-ERBB2"
        :quotes ("VERIFIED weak_attribution=7")
        :explanation "Citations graded weak attribution for ERBB2"))

