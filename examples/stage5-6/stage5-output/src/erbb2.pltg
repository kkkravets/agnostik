    :evidence (evidence "registry-ERBB2"
        :quotes ("VERIFIED off_target=0")
        :explanation "Citations graded off target for ERBB2"))

(fact title-drift 0
    :evidence (evidence "registry-ERBB2"
        :quotes ("VERIFIED title_drift=0")
        :explanation "Citations graded title drift for ERBB2"))

(fact retracted 0
    :evidence (evidence "registry-ERBB2"
        :quotes ("VERIFIED retracted=0")
        :explanation "Citations graded retracted for ERBB2"))

