(fact finding-pmid-42401587 true
    :evidence (evidence "registry-ERBB2"
        :quotes ("pmid 42401587 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "ERBB2 appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

