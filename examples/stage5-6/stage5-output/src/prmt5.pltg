(fact finding-pmid-41513606 true
    :evidence (evidence "registry-PRMT5"
        :quotes ("pmid 41513606 | status=weak-attribution | gene_role=title | indication=absent | resolves=True")
        :explanation "record names no colorectal indication, so it does not speak to this disease"))

