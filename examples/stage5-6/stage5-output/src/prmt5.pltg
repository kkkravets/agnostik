; PRMT5 — registry verification results (stage 5)
; Every fact quotes docs/registry-PRMT5.txt, which is the recorded registry response.

(fact subject-records 2
    :evidence (evidence "registry-PRMT5"
        :quotes ("VERIFIED subject_records=2")
        :explanation "Citations graded subject records for PRMT5"))

(fact weak-attribution 7
    :evidence (evidence "registry-PRMT5"
        :quotes ("VERIFIED weak_attribution=7")
        :explanation "Citations graded weak attribution for PRMT5"))

(fact off-target 0
    :evidence (evidence "registry-PRMT5"
        :quotes ("VERIFIED off_target=0")
        :explanation "Citations graded off target for PRMT5"))

(fact title-drift 0
    :evidence (evidence "registry-PRMT5"
        :quotes ("VERIFIED title_drift=0")
        :explanation "Citations graded title drift for PRMT5"))

(fact retracted 0
