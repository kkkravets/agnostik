; KRAS — registry verification results (stage 5)
; Every fact quotes docs/registry-KRAS.txt, which is the recorded registry response.

(fact subject-records 3
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED subject_records=3")
        :explanation "Citations graded subject records for KRAS"))

(fact weak-attribution 7
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED weak_attribution=7")
        :explanation "Citations graded weak attribution for KRAS"))

(fact off-target 1
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED off_target=1")
        :explanation "Citations graded off target for KRAS"))

(fact title-drift 0
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED title_drift=0")
        :explanation "Citations graded title drift for KRAS"))

(fact retracted 0
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED retracted=0")
        :explanation "Citations graded retracted for KRAS"))

(fact unresolved 0
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED unresolved=0")
        :explanation "Citations graded unresolved for KRAS"))

(fact not-checked 0
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED not_checked=0")
        :explanation "Citations graded not checked for KRAS"))

(fact checked-total 11
    :evidence (evidence "registry-KRAS"
        :quotes ("VERIFIED checked_total=11")
        :explanation "Citations graded checked total for KRAS"))

(fact finding-pmid-42527030 true
    :evidence (evidence "registry-KRAS"
        :quotes ("pmid 42527030 | status=off-target | gene_role=absent | indication=title | resolves=True")
        :explanation "KRAS appears nowhere in the registry record, under any of its names"))

(fact finding-pmid-42557320 true
    :evidence (evidence "registry-KRAS"
        :quotes ("pmid 42557320 | status=weak-attribution | gene_role=abstract | indication=abstract | resolves=True")
        :explanation "KRAS appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

(fact finding-pmid-42570059 true
    :evidence (evidence "registry-KRAS"
        :quotes ("pmid 42570059 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "KRAS appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

(fact finding-pmid-42599639 true
    :evidence (evidence "registry-KRAS"
        :quotes ("pmid 42599639 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "KRAS appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

(fact finding-pmid-42605754 true
    :evidence (evidence "registry-KRAS"
        :quotes ("pmid 42605754 | status=weak-attribution | gene_role=abstract | indication=absent | resolves=True")
        :explanation "KRAS appears only in the abstract, not in the title, so it is not the subject of this record — and the record names no colorectal indication either"))

(fact finding-pmid-42606648 true
    :evidence (evidence "registry-KRAS"
        :quotes ("pmid 42606648 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "KRAS appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

(fact finding-pmid-42607542 true
    :evidence (evidence "registry-KRAS"
        :quotes ("pmid 42607542 | status=weak-attribution | gene_role=title | indication=absent | resolves=True")
        :explanation "record names no colorectal indication, so it does not speak to this disease"))

(fact finding-nct-NCT05176483 true
    :evidence (evidence "registry-KRAS"
        :quotes ("nct NCT05176483 | status=weak-attribution | gene_role=absent | indication=abstract | resolves=True")
        :explanation "trial record names no KRAS under any of its UniProt names — it was matched to this target by free-text search, and only the indication lines up"))

; --- derived: how much of this dossier's citation base is subject-level ---
(derive citations-all-sound (= weak-attribution 0) :using (weak-attribution))

(derive citations-none-off-target (= off-target 0) :using (off-target))

(derive citations-none-retracted (= retracted 0) :using (retracted))

(derive citations-all-resolve (= unresolved 0) :using (unresolved))
