    :evidence (evidence "registry-EGFR"
        :quotes ("pmid 42595923 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "EGFR appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

(fact finding-pmid-42609336 true
    :evidence (evidence "registry-EGFR"
        :quotes ("pmid 42609336 | status=weak-attribution | gene_role=abstract | indication=absent | resolves=True")
