; EGFR — registry verification results (stage 5)
; Every fact quotes docs/registry-EGFR.txt, which is the recorded registry response.

(fact subject-records 2
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED subject_records=2")
        :explanation "Citations graded subject records for EGFR"))

(fact weak-attribution 6
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED weak_attribution=6")
        :explanation "Citations graded weak attribution for EGFR"))

(fact off-target 0
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED off_target=0")
        :explanation "Citations graded off target for EGFR"))

(fact title-drift 0
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED title_drift=0")
        :explanation "Citations graded title drift for EGFR"))

(fact retracted 0
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED retracted=0")
        :explanation "Citations graded retracted for EGFR"))

(fact unresolved 0
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED unresolved=0")
        :explanation "Citations graded unresolved for EGFR"))

(fact not-checked 0
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED not_checked=0")
        :explanation "Citations graded not checked for EGFR"))

(fact checked-total 8
    :evidence (evidence "registry-EGFR"
        :quotes ("VERIFIED checked_total=8")
        :explanation "Citations graded checked total for EGFR"))

(fact finding-pmid-42492133 true
    :evidence (evidence "registry-EGFR"
        :quotes ("pmid 42492133 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "EGFR appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

(fact finding-pmid-42576549 true
    :evidence (evidence "registry-EGFR"
        :quotes ("pmid 42576549 | status=weak-attribution | gene_role=abstract | indication=title | resolves=True")
        :explanation "EGFR appears only in the abstract, not in the title, so it is not the subject of this record — the record is indexed to a colorectal indication, but about something else"))

